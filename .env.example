# Copy to .env.local (never committed). Set the same values in Vercel > Project > Settings > Environment Variables.
# Only NEXT_PUBLIC_* values reach the browser. Everything else stays on the server.

# 1 = every API route returns fixtures/demo-event.json and auth is skipped. No keys needed. Start here.
MOCK=1
# 1 = for the seeded demo event only, a live AI call that takes over 20s or fails serves the cached fixture answer.
DEMO_MODE=1

# Supabase > Project settings > API keys. The newer publishable / secret keys go in the same two slots.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI. Model names are env so we can swap to whatever the event credits cover without a code change.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o
# Embedding model for retrieval and ingest. Must output 1536 dimensions to match kb_chunks.embedding. Required for live calls.
OPENAI_MODEL_EMBED=

# Eventbrite. Draft only, never published. DEMO_DRAFT_URL is the fallback link if the API fails on stage.
EVENTBRITE_TOKEN=
EVENTBRITE_ORG_ID=
EVENTBRITE_DEMO_DRAFT_URL=

# Resend. Without a verified domain, send from onboarding@resend.dev to the email on your Resend account.
RESEND_API_KEY=
REMINDER_FROM=EvntX <onboarding@resend.dev>
REMINDER_TO=
# Any long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
APP_URL=http://localhost:3000

# Name shown in the greeting and sidebar when MOCK=1 (there is no signed-in user in MOCK).
DEMO_USER_NAME=Alex Morgan
